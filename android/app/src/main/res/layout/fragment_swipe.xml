<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main swipe content -->
    <LinearLayout
        android:id="@+id/swipeContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Media container (swipeable area) -->
        <FrameLayout
            android:id="@+id/mediaContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Image display -->
            <ImageView
                android:id="@+id/imageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no" />

            <!-- Video thumbnail -->
            <ImageView
                android:id="@+id/videoThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:importantForAccessibility="no" />

            <!-- Play button for videos -->
            <ImageView
                android:id="@+id/playButton"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_play"
                android:background="#80000000"
                android:padding="16dp"
                android:visibility="gone"
                android:contentDescription="@string/video_label" />

            <!-- Delete overlay (red) -->
            <View
                android:id="@+id/overlayDelete"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/overlay_delete"
                android:alpha="0" />

            <!-- Keep overlay (green) -->
            <View
                android:id="@+id/overlayKeep"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/overlay_keep"
                android:alpha="0" />

            <!-- Overlay icon - Delete -->
            <ImageView
                android:id="@+id/iconOverlayDelete"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_delete"
                android:alpha="0"
                android:padding="16dp"
                android:importantForAccessibility="no" />

            <!-- Overlay icon - Keep -->
            <ImageView
                android:id="@+id/iconOverlayKeep"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_keep"
                android:alpha="0"
                android:padding="16dp"
                android:importantForAccessibility="no" />

            <!-- Mode banner (animated feedback for sort/random toggles) -->
            <LinearLayout
                android:id="@+id/modeBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_mode_banner"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:elevation="8dp"
                android:visibility="gone"
                android:translationY="-100dp">

                <TextView
                    android:id="@+id/tvBannerIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="24sp"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvBannerTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBannerSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#CCFFFFFF"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Top Right Badges -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Photo date badge (subtle) -->
                <TextView
                    android:id="@+id/tvMediaDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_counter"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="#CCFFFFFF"
                    android:textSize="11sp"
                    android:shadowColor="#CC000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="3" />

                <!-- Counter badge -->
                <TextView
                    android:id="@+id/tvCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_counter"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Video duration badge -->
            <TextView
                android:id="@+id/tvVideoBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="16dp"
                android:background="@drawable/bg_counter"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="@string/video_label"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Swipe hint -->
            <TextView
                android:id="@+id/tvSwipeHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="8dp"
                android:text="@string/swipe_hint"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:alpha="0.7" />


            <!-- File info -->
            <TextView
                android:id="@+id/tvFileInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="16dp"
                android:layout_marginBottom="28dp"
                android:background="@drawable/bg_counter"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:shadowColor="#CC000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="3" />

            <!-- Share button -->
            <ImageButton
                android:id="@+id/btnShareMedia"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="28dp"
                android:src="@drawable/ic_share"
                android:background="@drawable/bg_counter"
                android:padding="10dp"
                android:contentDescription="@string/share" />

        </FrameLayout>

        <!-- Bottom button bar -->
        <LinearLayout
            android:id="@+id/buttonBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:background="@color/surface_dark"
            android:gravity="center">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDelete"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/btn_delete"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/delete_red"
                    app:icon="@drawable/ic_delete"
                    app:iconTint="@color/white"
                    app:cornerRadius="16dp"
                    xmlns:app="http://schemas.android.com/apk/res-auto" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnKeep"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/btn_keep"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/keep_green"
                    app:icon="@drawable/ic_keep"
                    app:iconTint="@color/white"
                    app:cornerRadius="16dp"
                    xmlns:app="http://schemas.android.com/apk/res-auto" />

            </LinearLayout>

            <!-- Decidir depois - small subtle button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDecideLater"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="2dp"
                android:text="@string/btn_decide_later"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:minHeight="0dp"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                app:rippleColor="@color/surface_elevated" />

        </LinearLayout>


    </LinearLayout>

    <!-- All clean view (shown when no media left to review) -->
    <LinearLayout
        android:id="@+id/allCleanView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/emoji_party"
            android:textSize="72sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/all_clean_title"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/all_clean_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:gravity="center" />

        <!-- Permission hint (shown only when no full access) -->
        <TextView
            android:id="@+id/tvAllCleanPermissionHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/all_clean_no_permission_hint"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAllCleanGrantPermission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/btn_grant_permission"
            android:textAllCaps="false"
            android:backgroundTint="@color/accent_blue"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            app:cornerRadius="16dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- No permission view -->
    <LinearLayout
        android:id="@+id/noPermissionView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/emoji_lock"
            android:textSize="72sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/no_permission_title"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/no_permission_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:gravity="center" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGrantPermission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/btn_grant_permission"
            android:textAllCaps="false"
            android:backgroundTint="@color/accent_blue"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            app:cornerRadius="16dp" />

    </LinearLayout>

    <!-- Loading indicator -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:visibility="gone"
        android:indeterminateTint="@color/accent_blue" />

</FrameLayout>
